# ── Campaigns module ─────────────────────────────────────────────────────────
# Copy the relevant lines into .env.local (local) or Vercel env (staging/prod).
# No secret values belong in this file.

# Feature flag. Anything but "true" hides /campaigns, /portal and their APIs (404);
# the rest of the Hub keeps working unchanged.
CAMPAIGNS_MODULE_ENABLED=true

# Server-only Postgres connection used by the module (pg driver).
# Production: the Supabase pooler URL in TRANSACTION mode (port 6543), with a
# role that can read/write the cm_ tables. Never expose it to the browser.
CAMPAIGNS_DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres
CAMPAIGNS_DB_POOL_MAX=3

# File storage: "supabase" (private bucket, signed URLs) or "local" (dev only).
CAMPAIGNS_STORAGE=supabase
CAMPAIGNS_STORAGE_BUCKET=campaign-media
# Size limits per kind (MB). Keep at or below the bucket's own file size limit.
CAMPAIGNS_MAX_IMAGE_MB=25
CAMPAIGNS_MAX_VIDEO_MB=500
CAMPAIGNS_MAX_PDF_MB=25
# dev only:
# CAMPAIGNS_LOCAL_STORAGE_DIR=.data/campaign-media
# CAMPAIGNS_LOCAL_STORAGE_SECRET=<random string>

# Email: "gmail" (service account with domain-wide delegation, existing Hub
# setup via GOOGLE_SERVICE_ACCOUNT_KEY) or "dev" (records the message as
# "not sent — development environment"; nothing is delivered).
CAMPAIGNS_EMAIL_TRANSPORT=dev
CAMPAIGNS_EMAIL_FROM=campaigns@yourdomain
CAMPAIGNS_EMAIL_FROM_NAME=Leaders
# Staging safety valve: when set, EVERY message goes to this one inbox.
# CAMPAIGNS_EMAIL_REDIRECT_TO=qa-inbox@yourdomain

# Cron authentication. Required in production; the worker refuses to run without it.
CRON_SECRET=<random string, also set in Vercel>

# Absolute app URL used in emailed links.
NEXT_PUBLIC_APP_URL=https://your-hub-domain

# Local development only. Never set in production (ignored there anyway).
# CAMPAIGNS_DEV_AUTH=true
